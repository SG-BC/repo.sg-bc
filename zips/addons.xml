<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repo.sg-bc" name="SG-BC Add-ons" version="1.0.0" provider-name="SG-BC">
    <extension point="xbmc.addon.repository" name="SG-BC Add-ons Repository">
        <info compressed="false">https://raw.githubusercontent.com/SG-BC/repo.sg-bc/main/zips/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/SG-BC/repo.sg-bc/main/zips/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/SG-BC/repo.sg-bc/main/zips/</datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">SG-BC add-ons</summary>
        <description lang="en_GB">Repository for SG-BC Kodi add-ons.</description>
        <platform>all</platform>
    </extension>
</addon>
<addon id="service.watch.tracker" name="Watch Tracker" version="1.7.0" provider-name="SG-BC">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.22.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="plugin.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="login"/>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Watch tracker for multiple services</summary>
        <description lang="en_GB">Watch tracker for multiple services</description>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <news>v1.6.2 - Edit recent items: "this episode and all previous episodes" now works for shows outside the Kodi library
v1.6.1 - Reading from WeTrakr is now fast (a few calls instead of hundreds) and no longer fails on ratings
v1.6.0 - AniList, WeTrakr in the sync lists, edit recent items by hand, watchlist widget, rating-date option back</news>
    </extension>
</addon>
</addons>
